root ::= request

request ::= "{\"schema\":\"wellmanifest.twin-lifecycle/v1\",\"kind\":\"transition-request\",\"requestId\":" request-id ",\"twinRef\":" twin-ref ",\"blueprint\":" blueprint-ref ",\"action\":" name ",\"fromStage\":" name ",\"toStage\":" name ",\"baseRevision\":" revision ",\"requestedBy\":" actor ",\"evidenceRefs\":" evidence-array ",\"gateDecisionRef\":" decision-or-null ",\"idempotencyKey\":" idempotency "}"

blueprint-ref ::= "{\"blueprintId\":" ident ",\"version\":" blueprint-version ",\"definitionUri\":" definition-uri ",\"definitionDigest\":" digest ",\"immutable\":true}"
actor ::= "{\"actorRef\":" actor-ref ",\"actorClass\":" actor-class "}"
actor-class ::= "\"human\"" | "\"service\"" | "\"twin-persona\""

request-id ::= "\"request:" safe "\""
idempotency ::= "\"idempotency:" safe "\""
ident ::= "\"" safe "\""
name ::= "\"" lower name-tail "\""
name-tail ::= name-char name-tail | ""
name-char ::= lower | digit | "-"
blueprint-version ::= "\"v" nonzero digits "\""
definition-uri ::= "\"lifecycle://" host "/" safe "/v" nonzero digits "\""
twin-ref ::= "\"twin://" host "/" path "\""
actor-ref ::= "\"actor://" host "/" path "\""
evidence-array ::= "[" evidence-list "]"
evidence-list ::= evidence | evidence "," evidence-list
evidence ::= "\"evidence://" host "/" path "/r" nonzero digits "\""
decision-or-null ::= "null" | "\"decision://" host "/" path "\""
digest ::= "\"sha256:" hex64 "\""
revision ::= "\"" hex40 "\"" | "\"sha256:" hex64 "\""

host ::= host-char host-tail
host-tail ::= host-char host-tail | ""
host-char ::= lower | digit | "." | "-"
path ::= path-char path-tail
path-tail ::= path-char path-tail | ""
path-char ::= lower | upper | digit | "." | "_" | ":" | "/" | "-"
safe ::= lower safe-tail
safe-tail ::= safe-char safe-tail | ""
safe-char ::= lower | digit | "." | "_" | "-"
digits ::= digit digits | ""
hex40 ::= hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex
hex64 ::= hex40 hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex
hex ::= digit | [a-f]
lower ::= [a-z]
upper ::= [A-Z]
digit ::= [0-9]
nonzero ::= [1-9]
